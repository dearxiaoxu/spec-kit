# =============================================
# Spec-Kit 自动化测试环境变量配置（复制为 .env 后修改）
# =============================================

# 目标环境地址（默认方案B现网；方案A测试环境请替换）
BASE_URL=https://106.54.60.191

# 测试账号（member 角色）
USERNAME=Xuhp
PASSWORD=668708@Xuhp

# admin 账号（管理后台用例需要）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# 是否忽略 HTTPS 证书校验（自签名证书必须为 true）
IGNORE_HTTPS_ERRORS=true

# 测试超时（毫秒）
TIMEOUT=30000

# AI 相关用例是否执行（true 会调用真实模型产生费用）
RUN_AI_TESTS=false
